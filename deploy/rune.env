# Rune production environment -- /etc/rune/rune.env
# All vars prefixed RUNE_ map to backend/config.py RuneSettings fields.

# OBD-II: use real WiCAN Pro, not simulator
RUNE_USE_SIMULATOR=false

# Database: Pi-local SQLite (dir created by setup.sh)
RUNE_DB_PATH=/var/lib/rune/rune.db

# Logging: warning in prod (info is noisy at 10Hz)
RUNE_LOG_LEVEL=WARNING

# WiCAN Pro on the Rune WiFi network
RUNE_WICAN_HOST=192.168.4.100
RUNE_WICAN_PORT=3333

# Gas price (update weekly via settings screen or here)
RUNE_GAS_PRICE_PER_GALLON=3.50
